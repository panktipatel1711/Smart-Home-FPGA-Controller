# FPGA Pin Mapping (Example: Artix-7)
set_property PACKAGE_PIN W5 [get_ports clk_50m_i]
set_property IOSTANDARD LVCMOS33 [get_ports clk_50m_i]
set_property PACKAGE_PIN U18 [get_ports reset_btn_i]
set_property IOSTANDARD LVCMOS33 [get_ports reset_btn_i]
set_property PACKAGE_PIN V17 [get_ports sw_auto_i]
set_property IOSTANDARD LVCMOS33 [get_ports sw_auto_i]
